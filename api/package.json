{
  "name": "@kortex/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate-validators.mjs",
    "dev": "pnpm run generate && wrangler dev --local --env= --ip 127.0.0.1 --port 8787",
    "test": "pnpm run generate && node --test tests/contracts.test.mjs && vitest run",
    "typecheck": "pnpm run generate && tsc --noEmit -p tsconfig.json",
    "lint": "pnpm run typecheck",
    "build": "pnpm run generate && wrangler deploy --dry-run --env= --outdir dist",
    "check:cloudflare": "node scripts/check-cloudflare.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@cloudflare/workers-types": "5.20261027.1",
    "@types/node": "24.10.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  }
}
