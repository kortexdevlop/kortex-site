{
  "contract_version": "1.0",
  "tool_id": "compresseur-images",
  "actions": [
    {
      "id": "compress_image",
      "description": "Compresser une image JPEG, PNG ou WebP en conservant la transparence",
      "input_schema": {
        "type": "object",
        "properties": {
          "data_base64": {
            "type": "string",
            "maxLength": 933336
          },
          "quality": {
            "type": "integer",
            "minimum": 30,
            "maximum": 95
          }
        },
        "required": [
          "data_base64",
          "quality"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "data_base64": {
            "type": "string",
            "maxLength": 933336
          },
          "format": {
            "type": "string",
            "enum": [
              "jpeg",
              "png",
              "webp"
            ]
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "height": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4096
          },
          "original_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 700000
          },
          "compressed_size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 700000
          },
          "reduced": {
            "type": "boolean"
          }
        },
        "required": [
          "data_base64",
          "format",
          "width",
          "height",
          "original_size",
          "compressed_size",
          "reduced"
        ],
        "additionalProperties": false
      },
      "permissions": [],
      "side_effect": "none",
      "idempotent": true,
      "timeout_ms": 10000
    }
  ]
}
