{
  "contract_version": "1.0",
  "tool_id": "comparateur-texte",
  "actions": [
    {
      "id": "diff",
      "description": "Comparer deux textes ligne par ligne (400 lignes maximum chacun)",
      "input_schema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "string",
            "maxLength": 16384
          },
          "b": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "required": [
          "a",
          "b"
        ],
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 40000
          },
          "added": {
            "type": "integer",
            "minimum": 0,
            "maximum": 400
          },
          "removed": {
            "type": "integer",
            "minimum": 0,
            "maximum": 400
          }
        },
        "required": [
          "text",
          "added",
          "removed"
        ],
        "additionalProperties": false
      },
      "permissions": [],
      "side_effect": "none",
      "idempotent": true,
      "timeout_ms": 3000
    }
  ]
}
