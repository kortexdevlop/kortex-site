---
import '../styles/global.css';
import '../styles/auth.css';
interface Props {title:string;}
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('Referrer-Policy','no-referrer');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>{Astro.props.title} — Kortex</title><link rel="icon" href="/favicon.svg"/></head><body class="auth-body"><a class="auth-brand" href="/" aria-label="Kortex.site — accueil"><span aria-hidden="true"></span><strong>kortex<span>.site</span></strong></a><main id="main" class="auth-main"><slot/></main><a class="auth-guest" href="/">Continuer sans compte →</a><nav aria-label="Informations légales" class="auth-guest"><a href="/mentions-legales">Mentions légales</a> · <a href="/confidentialite">Confidentialité</a> · <a href="/conditions-utilisation">Conditions d’utilisation</a></nav></body></html>
