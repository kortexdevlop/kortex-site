---
import '../styles/global.css';
import '../styles/landing.css';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
interface Props {title:string;dated?:boolean;}
const {title,dated=true}=Astro.props;
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>{title} — Kortex</title><link rel="icon" href="/favicon.svg"/><script is:inline src="/theme.js"></script></head><body class="landing-body"><div class="ambient" aria-hidden="true"></div><a class="skip-link" href="#main">Aller au contenu</a><div class="landing"><SiteNav/><main id="main" class="legal-main"><h1>{title}</h1>{dated&&<p class="legal-date">Mise à jour : 30 octobre 2026</p>}<slot/></main><Footer/></div></body></html>
<style>
.legal-main{max-width:900px;margin:32px auto 48px;padding:clamp(24px,5vw,56px);background:rgb(var(--glass-rgb) / .72);backdrop-filter:blur(40px) saturate(180%);border:1px solid rgb(var(--glass-rgb) / .85);border-radius:var(--radius-large);box-shadow:var(--shadow-soft);line-height:1.75;overflow-wrap:anywhere}.legal-main h1{font-size:clamp(28px,5vw,42px);line-height:1.2;font-weight:600;letter-spacing:-.04em;margin-bottom:var(--spacing-3)}.legal-date{color:var(--muted)}.legal-main :global(h2){font-size:22px;margin-top:36px}.legal-main :global(a){text-decoration:underline;text-underline-offset:3px}.legal-main :global(li){margin:8px 0}.legal-main :global(code){padding:2px 6px;border-radius:6px;background:var(--sunken);font-family:var(--font-mono);font-size:.875em}@media(max-width:600px){.legal-main{margin:16px 0 32px}}
</style>
