---
import '../styles/global.css';
interface Props {title:string;}
---
<!doctype html><html lang="fr"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><title>{Astro.props.title} — Kortex</title><link rel="icon" href="/favicon.svg"/></head><body><a class="skip-link" href="#main">Aller au contenu</a><header class="legal-head"><a href="/" aria-label="Kortex.site — accueil"><strong>kortex<span>.site</span></strong></a><a href="/auth/login">Mon compte</a></header><main id="main" class="legal-main"><h1>{Astro.props.title}</h1><p class="legal-date">Mise à jour : 30 octobre 2026</p><slot/></main><footer class="legal-foot"><nav aria-label="Informations légales"><a href="/mentions-legales">Mentions légales</a><a href="/confidentialite">Confidentialité</a><a href="/conditions-utilisation">Conditions d’utilisation</a></nav><a href="/">Retour à Kortex</a></footer></body></html>
<style>
body{background:#f4f6fa;color:#17191d}.legal-head,.legal-foot{max-width:1000px;margin:auto;padding:28px 24px;display:flex;justify-content:space-between;gap:24px;flex-wrap:wrap}.legal-head strong{font-size:24px;letter-spacing:-1px}.legal-head strong span{color:#737982;font-weight:400}.legal-main{max-width:900px;margin:16px auto;padding:clamp(24px,5vw,56px);background:#fff;border:1px solid #e4e7ec;border-radius:28px;line-height:1.75}.legal-main h1{font-size:clamp(28px,5vw,42px);line-height:1.2}.legal-date{color:#646b74}.legal-main :global(h2){font-size:22px;margin-top:36px}.legal-main :global(a){text-decoration:underline;text-underline-offset:3px}.legal-main :global(li){margin:8px 0}.legal-foot nav{display:flex;gap:20px;flex-wrap:wrap}a:focus-visible{outline:3px solid #2461b5;outline-offset:4px}@media(max-width:600px){.legal-main{margin:8px 12px}.legal-foot nav{flex-direction:column;gap:12px}}
</style>
