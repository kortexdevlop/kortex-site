---
import {env} from 'cloudflare:workers';
import AppLayout from '../../layouts/AppLayout.astro';
import AIAssistant from '../../components/AIAssistant';
import {runtimeOrigin} from '../../lib/runtime-bridge';
const origin=runtimeOrigin(env.PUBLIC_RUN_ORIGIN,Astro.url.origin);
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('Content-Security-Policy',`default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src ${origin||"'none'"}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'`);
Astro.response.headers.set('Referrer-Policy','no-referrer');
---
<AppLayout title="Assistant — Kortex"><AIAssistant client:load origin={origin}/></AppLayout>
<style is:global>.ai-assistant{max-width:1000px;margin:auto;padding:32px 8px;color:var(--ws-text,#171a1d)}.ai-assistant h1{font-size:40px;letter-spacing:-1px}.ai-assistant form,.ai-local,.ai-step,.ai-runtime{padding:24px;border:1px solid #e2e6eb;border-radius:24px;background:#ffffffb8;margin:20px 0}.ai-assistant textarea{display:block;width:100%;min-height:120px;border:1px solid #dce2e8;border-radius:16px;padding:16px;font:inherit;margin:10px 0}.ai-assistant button{border:1px solid #dce2e8;border-radius:12px;padding:10px 16px;font:inherit;background:#f8fafc;cursor:pointer}.ai-assistant button[type=submit]{background:#111415;color:#fff}.ai-assistant button:disabled{opacity:.5;cursor:default}.ai-consent{display:block;margin:16px 0}.ai-local label{display:block;margin:18px 0 8px}.ai-assistant pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#f0f4f8;border-radius:12px;padding:14px;color:#202832}.ai-runtime iframe{width:100%;height:480px;border:0;border-radius:16px}.ai-result{border-left:3px solid #32a572;padding-left:14px}.ai-assistant :focus-visible{outline:3px solid #2588ad;outline-offset:3px}@media(max-width:600px){.ai-assistant{padding:16px 0}.ai-assistant h1{font-size:30px}.ai-step,.ai-local,.ai-assistant form{padding:16px}}</style>
