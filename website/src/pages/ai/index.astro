---
import {env} from 'cloudflare:workers';
import WorkspaceLayout from '../../layouts/WorkspaceLayout.astro';
import '../../styles/ai.css';
import AIAssistant from '../../components/AIAssistant';
import {runtimeOrigin} from '../../lib/runtime-bridge';
const origin=runtimeOrigin(env.PUBLIC_RUN_ORIGIN,Astro.url.origin);
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('Content-Security-Policy',`default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-src ${origin||"'none'"}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'`);
Astro.response.headers.set('Referrer-Policy','no-referrer');
---
<WorkspaceLayout title="Assistant — Kortex"><AIAssistant client:load origin={origin}/></WorkspaceLayout>
