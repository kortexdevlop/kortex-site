---
import AuthLayout from '../../layouts/AuthLayout.astro';
---
<AuthLayout title="Connecter Kortex Desktop"><section class="auth-card" data-connect-desktop><p class="auth-eyebrow">APPLICATION WINDOWS</p><h1>Connecter cet appareil</h1><p>Autorisez Kortex Desktop à lire votre compte et à synchroniser vos favoris et réglages si vous activez cette option. Aucun fichier ne sera envoyé.</p><p class="auth-help">Vérifiez que vous venez de demander cette connexion depuis Kortex Desktop.</p><p class="auth-status" role="status" data-connect-status>Chargement…</p><button type="button" class="auth-submit" data-approve-device disabled>Autoriser cet appareil</button><a class="auth-guest" href="/account">Annuler</a></section></AuthLayout>
<script>
 import {accountSession,accountRequest,accountHeaders} from '../../lib/account-client';
 const requestId=new URLSearchParams(location.search).get('request_id'),button=document.querySelector<HTMLButtonElement>('[data-approve-device]')!,status=document.querySelector<HTMLElement>('[data-connect-status]')!;let owner:Awaited<ReturnType<typeof accountSession>>;
 void(async()=>{if(!requestId||!/^[0-9a-f-]{36}$/.test(requestId))throw Error('Invalid request');owner=await accountSession();const response=await accountRequest('/api/v1/auth/desktop/request?id='+requestId),body=await response.json() as {redirect_uri:string};const target=new URL(body.redirect_uri);if(target.hostname!=='127.0.0.1'||target.protocol!=='http:')throw Error('Invalid target');status.textContent='La demande est prête. Retour vers votre application sur cet appareil.';button.disabled=false})().catch(()=>status.textContent='Cette demande est invalide ou a expiré. Recommencez depuis l’application.');
 button.addEventListener('click',async()=>{button.disabled=true;try{const response=await accountRequest('/api/v1/auth/desktop/approve',{method:'POST',headers:accountHeaders(owner),body:JSON.stringify({request_id:requestId})}),body=await response.json() as {redirect_url:string};const target=new URL(body.redirect_url);if(target.protocol!=='http:'||target.hostname!=='127.0.0.1'||target.pathname!=='/callback')throw Error('Invalid target');location.assign(target.href)}catch{status.textContent='La connexion n’a pas abouti. Recommencez depuis l’application.'}});
</script>
