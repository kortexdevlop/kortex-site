---
import AuthLayout from '../../layouts/AuthLayout.astro';
const email=Astro.locals.account?.email??'Compte Google';
---
<AuthLayout title="Mon compte" account="profile"><div data-account class="account-page"><div><h1>Profil</h1><p class="account-lead">Vos fichiers restent sur votre appareil. La synchronisation des favoris et réglages est facultative.</p></div><section class="account-panel"><div class="account-profile"><span class="account-avatar" aria-hidden="true">{email[0].toLocaleUpperCase('fr')}</span><div><strong data-account-email>{email}</strong><p class="auth-help" data-email-verification hidden>Adresse email non vérifiée</p></div></div><div class="account-row"><a class="account-btn account-btn-dark" href="/workspace">Retrouver mes outils</a><button type="button" class="account-btn account-out" data-logout disabled>Se déconnecter</button></div><p class="auth-status" role="status" aria-live="polite" data-auth-status></p></section></div></AuthLayout>
<script>import '../../scripts/password-auth';</script>
