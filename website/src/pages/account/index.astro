---
import AuthLayout from '../../layouts/AuthLayout.astro';
---
<AuthLayout title="Mon compte"><section class="auth-card" data-account><p class="auth-eyebrow">VOTRE ESPACE KORTEX</p><h1>Mon compte</h1><p class="auth-description" data-account-email>{Astro.locals.account?.email??'Compte Google'}</p><p class="auth-help" data-email-verification hidden>Adresse email non vérifiée</p><p class="auth-description">Vos fichiers restent sur votre appareil. La synchronisation des favoris et réglages est facultative.</p><nav class="account-nav" aria-label="Mon compte"><a href="/account/library">Ma bibliothèque</a><a href="/account/settings">Réglages et données</a></nav><a class="auth-submit auth-open" href="/">Retrouver mes outils</a><p class="auth-status" role="status" aria-live="polite" data-auth-status></p><button type="button" class="auth-google" data-logout disabled>Se déconnecter</button></section></AuthLayout>
<script>import '../../scripts/password-auth';</script>
