---
import {env} from 'cloudflare:workers';
import WorkspaceLayout from '../../layouts/WorkspaceLayout.astro';
import Workspace from '../../components/Workspace.astro';
import ToolDetails from '../../components/ToolDetails.astro';
import {ApiClient,ApiUnavailable} from '../../lib/api-client';
import {canonical} from '../../lib/urls';
import {software,jsonLd} from '../../lib/seo';
import type {ToolDetail,ToolSummary} from '../../lib/tools';
export const prerender=false;
let detail:ToolDetail|undefined,status=200;
const client=new ApiClient(env.API_WORKER);let related:ToolSummary[]=[];
try{detail=await client.getTool(Astro.params.id!);}catch(e){status=e instanceof ApiUnavailable?e.status:503;}
if(detail)try{related=(await client.listTools(new URLSearchParams({category:detail.tool.category,limit:'5'}))).items.filter(t=>t.id!==detail!.tool.id).slice(0,4);}catch{}
Astro.response.status=status;
Astro.response.headers.set('Cache-Control',status===200?'public, max-age=60':'no-store');
---
<WorkspaceLayout structuredData={detail?jsonLd(software(detail,env.WEB_ORIGIN||Astro.url.origin)):undefined} title={detail?.manifest.seo.title||'Outil indisponible — Kortex'} description={detail?.manifest.seo.description} canonicalUrl={status===200?canonical('/tools/'+encodeURIComponent(Astro.params.id!),env.WEB_ORIGIN||Astro.url.origin):undefined} indexable={status===200}><Workspace tools={[]} pageKind="detail"><section class="ws-detail"><a class="ws-back" href="/tools">← Tous les outils</a>{detail?<ToolDetails detail={detail} related={related}/>:<><h1>{status===404?'Outil introuvable':'Service indisponible'}</h1><p>{status===404?'Cet outil n’est pas publié ou n’existe plus.':'Réessayez dans quelques instants.'}</p></>}</section></Workspace></WorkspaceLayout>
