---
import type {ToolDetail} from '../lib/tools';
import Icon from './ui/Icon.astro';
interface Props {detail:ToolDetail;origin:string|null;}
const {detail,origin}=Astro.props;
---
<main class="ws-viewer tool-frame" id="workspace-main" data-runtime-viewer data-origin={origin} data-id={detail.tool.id} data-version={detail.tool.version} data-min-runtime={detail.manifest.min_runtime} data-abi={detail.manifest.abi_version}>
  <header class="tool-frame-bar"><span class:list={['ws-tile tool-frame-tile',`ws-hue-${detail.tool.category}`]}><Icon name={detail.tool.category} size={16} stroke={2}/></span><h1>{detail.tool.name}</h1><span class="tool-frame-version">v{detail.tool.version}</span><span class="tool-frame-spacer"></span><p class="tool-frame-pill" role="status" data-runtime-status>{origin?'Connexion à l’espace sécurisé…':'L’espace d’exécution n’est pas configuré. Réessayez après son activation.'}</p><a class="tool-frame-close" href="/tools" aria-label="Tous les outils"><Icon name="close" size={15} stroke={1.8}/></a></header>
  <div class="tool-frame-tools"><span class="tool-frame-local">Exécution sur votre appareil</span><details><summary>Permissions demandées</summary><div>{detail.manifest.permissions.length?<ul>{detail.manifest.permissions.map(permission=><li>{permission}</li>)}</ul>:<p>Aucune permission sensible demandée.</p>}<p>Les autorisations sont gérées dans l’outil.</p></div></details><span class="tool-frame-spacer"></span><a href={`/tools/${encodeURIComponent(detail.tool.id)}`}>Fiche de l’outil</a></div>
  <div class="tool-frame-body">{origin&&<iframe data-src={origin+'/frame.html?tool='+encodeURIComponent(detail.tool.id)+'&version='+encodeURIComponent(detail.tool.version)} sandbox="allow-scripts allow-same-origin allow-downloads" referrerpolicy="no-referrer" title={`Outil : ${detail.tool.name}`} allow="camera 'none'; microphone 'none'; geolocation 'none'"/>}</div>
</main>
<script>
import {verifyRuntime,requireRuntime} from '../../../shared/typescript/src/runtime';
import stagingRoot from '../../../infra/trust/release-staging-root.json';
import productionRoot from '../../../infra/trust/release-production-root.json';
import {connectRuntime} from '../lib/runtime-bridge';
// Production builds pin only the independent production root; every other build pins the staging root.
const runtimeRoot=import.meta.env.PUBLIC_KORTEX_TRUST==='production'?productionRoot:stagingRoot;
const viewer=document.querySelector<HTMLElement>('[data-runtime-viewer]');
if(viewer?.dataset.origin){const frame=viewer.querySelector('iframe')!;const status=viewer.querySelector<HTMLElement>('[data-runtime-status]')!;
const labels:Record<string,string>={connecting:'Connexion à l’espace sécurisé…',loading:'Vérification et chargement de l’outil…',ready:'L’outil est prêt.',error:'Impossible d’ouvrir cet outil. Rechargez la page pour réessayer.'};
void (async()=>{try{const key='kortex.runtime.v1:'+runtimeRoot.id;const previous=JSON.parse(localStorage.getItem(key)||'null');const floor=Number.isSafeInteger(previous?.sequence)&&previous.sequence>0?previous.sequence:1;const response=await fetch('/api/v1/runtime/channels',{credentials:'same-origin',cache:'no-store',redirect:'error',signal:AbortSignal.timeout(8000)});if(!response.ok)throw Error('RUNTIME_UNAVAILABLE');const d=await verifyRuntime(await response.json(),runtimeRoot,floor);const release=Object.values(d.channels).find(r=>r?.web.origin===viewer.dataset.origin);if(!release)throw Error('RUNTIME_UNAVAILABLE');requireRuntime({min_runtime:viewer.dataset.minRuntime!,abi_version:viewer.dataset.abi!},release.runtime_version);localStorage.setItem(key,JSON.stringify({sequence:d.sequence,version:release.runtime_version}));const src=new URL(frame.dataset.src!);src.searchParams.set('runtime',release.runtime_version);frame.src=src.href;const stop=connectRuntime(frame,viewer.dataset.origin!,viewer.dataset.id!,viewer.dataset.version!,state=>{viewer.dataset.state=state;status.textContent=labels[state];});window.addEventListener('pagehide',stop,{once:true});}catch(error){viewer.dataset.state='error';status.textContent=error instanceof Error&&error.message==='UPDATE_REQUIRED'?'Une mise à jour de l’espace d’exécution est nécessaire. Réessayez après sa publication.':'La version sécurisée de l’espace d’exécution est indisponible. Réessayez plus tard.';}})();}
</script>
