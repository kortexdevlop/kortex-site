---
import type {ToolDetail} from '../lib/tools';
interface Props {detail:ToolDetail;origin:string|null;}
const {detail,origin}=Astro.props;
---
<section class="ws-viewer" data-runtime-viewer data-origin={origin} data-id={detail.tool.id} data-version={detail.tool.version}>
  <h1>{detail.tool.name}</h1><p>Version {detail.tool.version} · Exécution sur votre appareil</p>
  <details><summary>Permissions demandées</summary>{detail.manifest.permissions.length?<ul>{detail.manifest.permissions.map(permission=><li>{permission}</li>)}</ul>:<p>Aucune permission sensible demandée.</p>}<p>Les autorisations sont gérées dans l’outil.</p></details>
  <p role="status" data-runtime-status>{origin?'Connexion à l’espace sécurisé…':'L’espace d’exécution n’est pas configuré. Réessayez après son activation.'}</p>
  {origin&&<iframe src={origin+'/frame.html?tool='+encodeURIComponent(detail.tool.id)+'&version='+encodeURIComponent(detail.tool.version)} sandbox="allow-scripts allow-same-origin" referrerpolicy="no-referrer" title={`Outil : ${detail.tool.name}`} allow="camera 'none'; microphone 'none'; geolocation 'none'"/>}
  <p><a href={`/tools/${encodeURIComponent(detail.tool.id)}`}>← Fiche de l’outil</a> · <a href="/tools">Tous les outils</a></p>
</section>
<script>
import {connectRuntime} from '../lib/runtime-bridge';
const viewer=document.querySelector<HTMLElement>('[data-runtime-viewer]');
if(viewer?.dataset.origin){const frame=viewer.querySelector('iframe')!;const status=viewer.querySelector<HTMLElement>('[data-runtime-status]')!;
const labels:Record<string,string>={connecting:'Connexion à l’espace sécurisé…',loading:'Vérification et chargement de l’outil…',ready:'L’outil est prêt.',error:'Impossible d’ouvrir cet outil. Rechargez la page pour réessayer.'};
const stop=connectRuntime(frame,viewer.dataset.origin,viewer.dataset.id!,viewer.dataset.version!,state=>{viewer.dataset.state=state;status.textContent=labels[state];});window.addEventListener('pagehide',stop,{once:true});}
</script>
