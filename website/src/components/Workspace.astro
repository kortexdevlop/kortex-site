---
import {categories,type WorkspaceTool,type RecentItem} from '../lib/workspace';
import SearchDialog from './ui/SearchDialog';
import Pagination from './ui/Pagination.astro';
import {isToolSummary} from '../lib/tools';
interface Props {tools:WorkspaceTool[];execution?:boolean;pageKind?:'home'|'catalog'|'detail';next?:string|null;recent?:RecentItem[];preview?:boolean;unavailable?:boolean;hasMore?:boolean;connection?:{connected:boolean;description:string};account?:{initials:string;subtitle:string};}
const {tools,execution=false,pageKind='home',next=null,recent=[],preview=false,unavailable=false,hasMore=false,connection={connected:false,description:'Connectez Kortex Desktop pour retrouver vos outils locaux.'},account={initials:'K',subtitle:'Sans connexion'}}=Astro.props;
if(!tools.every(t=>isToolSummary(t.tool)))throw Error('Invalid workspace tools');
const groups=preview?(tools.some(t=>t.category==='other')?[...categories,{id:'other',label:'Autres'}]:categories):[...new Set([...tools.map(t=>t.tool.category),...(Astro.url.searchParams.get('category')?[Astro.url.searchParams.get('category')!]:[])])].sort().map(id=>({id,label:categories.find(c=>c.id===id)?.label||id}));
const specialPage=/^\/workspace(?:\/|$)/.test(Astro.url.pathname)?'Bureau':/^\/workflows(?:\/|$)/.test(Astro.url.pathname)?'Parcours':/^\/ai(?:\/|$)/.test(Astro.url.pathname)?'Assistant':null;
const nav=[{id:'home',label:'Accueil',count:null},{id:'all',label:'Tous les outils',count:pageKind==='detail'?null:tools.length},{id:'favorites',label:'Favoris',count:pageKind==='detail'?null:tools.filter(t=>t.favorite).length},{id:'installed',label:'Installés',count:pageKind==='detail'?null:tools.filter(t=>t.installed).length}];
---
<div class="workspace" data-demo={preview?'true':'false'} data-page-kind={pageKind} data-execution={execution?'true':undefined}>
  <aside class="ws-sidebar" id="workspace-sidebar" aria-label="Navigation de l’espace de travail">
    <a class="ws-brand" href={preview?'/__dev/design':'/'}><span class="ws-brand-mark" aria-hidden="true"></span><span><strong>kortex</strong><span class="ws-brand-site">.site</span></span> <span class="ws-beta">BETA</span><span class="sr-only"> — accueil</span></a>
    <button class="ws-new-task" type="button" data-new-task>Nouvelle tâche <kbd aria-hidden="true">⌘N</kbd></button>
    <nav class="ws-nav" aria-label="Espace de travail">{nav.map(item=><button type="button" class:list={['ws-nav-item',!specialPage&&item.id===(pageKind==='home'?'home':'all')&&'is-active']} data-section={item.id} aria-current={!specialPage&&item.id===(pageKind==='home'?'home':'all')?'page':undefined}><span class="ws-nav-icon" aria-hidden="true"></span><span>{item.label}</span>{item.count!==null&&<span class="ws-count" data-count={item.id}>{item.count}{item.id==='all'&&hasMore?'+':''}</span>}</button>)}</nav>
    {!preview&&<a class:list={['ws-nav-item',specialPage==='Assistant'&&'is-active']} aria-current={specialPage==='Assistant'?'page':undefined} href="/ai"><span class="ws-nav-icon" aria-hidden="true"></span><span>Assistant</span></a>}
    {!preview&&<a class:list={['ws-nav-item',specialPage==='Parcours'&&'is-active']} aria-current={specialPage==='Parcours'?'page':undefined} href="/workflows"><span class="ws-nav-icon" aria-hidden="true"></span><span>Parcours</span></a>}
    {!preview&&<a class:list={['ws-nav-item',specialPage==='Bureau'&&'is-active']} aria-current={specialPage==='Bureau'?'page':undefined} href="/workspace"><span class="ws-nav-icon" aria-hidden="true"></span><span>Bureau</span></a>}
    <div class="ws-categories"><p class="ws-category-heading">CATÉGORIES</p><nav aria-label="Catégories">{groups.map(group=><button type="button" class="ws-category" data-category={group.id}><span class:list={['ws-category-dot',`ws-color-${group.id}`]} aria-hidden="true"></span><span>{group.label}</span><span class="ws-count">{tools.filter(t=>(preview?t.category:t.tool.category)===group.id).length}</span></button>)}</nav></div>
    <div class="ws-sidebar-bottom"><div class="ws-connection"><p><span class:list={['ws-connection-dot',connection.connected&&'is-connected']} aria-hidden="true"></span>{connection.connected?'App locale connectée':'App locale non connectée'}</p><span>{connection.description}</span></div><button type="button" class="ws-account" data-open-account><span class="ws-avatar">{account.initials}</span><span><strong>Mon espace</strong><span>{account.subtitle}</span></span></button>{!preview&&<nav class="ws-legal-links" aria-label="Informations légales"><a href="/mentions-legales">Mentions légales</a><a href="/confidentialite">Confidentialité</a><a href="/conditions-utilisation">Conditions d’utilisation</a></nav>}</div>
  </aside>
  <div class="ws-drawer-backdrop" hidden></div>
  <section class="ws-main-panel">
    <header class="ws-topbar"><button class="ws-mobile-menu" type="button" aria-expanded="false" aria-controls="workspace-sidebar" aria-label="Ouvrir le menu">☰</button><div class="ws-breadcrumb"><span>Espace de travail</span><span aria-hidden="true">/</span><strong id="ws-page-name">{specialPage??(pageKind==='home'?'Accueil':pageKind==='catalog'?'Tous les outils':'Outil')}</strong></div><div class="ws-topbar-actions"><form class="ws-global-search" role="search" aria-label="Rechercher partout" action={preview?'/__dev/design':'/tools'}><span class="ws-search-circle" aria-hidden="true"></span><label class="sr-only" for="ws-global-query">Rechercher partout</label><input value={Astro.url.searchParams.get('q')||''} id="ws-global-query" name="q" type="search" placeholder="Rechercher partout" maxlength="200"/><kbd aria-hidden="true">⌘K</kbd></form><button class="ws-docs" type="button" data-open-docs>Docs</button></div></header>
    <main class="ws-scroll" id="workspace-main" tabindex="-1">
      <div class="ws-content">
        <section hidden={pageKind!=='home'} class="ws-hero" aria-labelledby="workspace-title"><h1 id="workspace-title">Que voulez-vous faire aujourd'hui ?</h1><p class="ws-subtitle">Décrivez votre besoin ou déposez un fichier. Kortex propose le bon outil.</p>
          <form class="ws-composer" action={preview?'/__dev/design':'/'} method="get"><label class="sr-only" for="ws-task">Décrivez votre besoin</label><textarea id="ws-task" name="q" placeholder="Ex. compresser 40 photos pour le web, convertir un PDF en Word..." maxlength="2000"></textarea><div class="ws-composer-footer"><button class="ws-attach" type="button">+ Déposer un fichier</button><input id="ws-file" type="file" class="sr-only" tabindex="-1" aria-label="Choisir un fichier"/><fieldset class="ws-modes"><legend class="sr-only">Disponibilité des outils</legend>{[['all','Tous'],['web','En ligne'],['local','Local']].map(([value,label])=><label><input type="radio" name="mode" value={value} checked={value==='all'}/><span>{label}</span></label>)}</fieldset><button class="ws-send" type="submit" aria-label="Trouver le bon outil"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 21V3m-5 6 5-6 5 6"/></svg></button></div><p class="ws-file-status" hidden></p></form>
          <div class="ws-suggestions" aria-label="Suggestions de tâches">{['Compresser une image','PDF vers Word','Formater du JSON','Créer un QR code'].map(label=><button type="button" data-suggestion={label}>{label}</button>)}</div>
        </section>
        <section hidden={pageKind!=='home'} class="ws-recent" aria-labelledby="ws-recent-title"><div class="ws-section-heading"><h2 id="ws-recent-title">Récents</h2><button class="ws-text-button" type="button" data-show-recent>Tout voir</button></div><div class="ws-recent-grid">{recent.map(item=><button type="button" class="ws-recent-card" data-recent={item.name}><span class:list={['ws-glyph',`ws-icon-${item.category}`]} aria-hidden="true">{item.glyph}</span><span><strong>{item.name}</strong><span>{item.subtitle}</span></span></button>)}{!recent.length&&<p class="ws-empty-recent">Vos activités récentes s’afficheront ici.</p>}</div></section>
        <slot/><section hidden={pageKind==='detail'} class="ws-library" id="workspace-tools" aria-labelledby="ws-tools-title"><div class="ws-section-heading"><h2 id="ws-tools-title">Tous les outils <span id="ws-visible-count">{tools.length} outils{hasMore?' affichés':''}</span></h2><div class="ws-view-switch" role="group" aria-label="Affichage des outils"><button type="button" data-view="grid" aria-pressed="true">Grille</button><button type="button" data-view="list" aria-pressed="false">Liste</button></div></div>
          {pageKind==='catalog'&&<form class="ws-catalog-filters" action="/tools"><label>Recherche <input type="search" name="q" maxlength="100" value={Astro.url.searchParams.get('q')||''}/></label><label>Catégorie <select name="category"><option value="">Toutes</option>{[...new Set(tools.map(t=>t.tool.category))].sort().map(c=><option value={c} selected={Astro.url.searchParams.get('category')===c}>{c}</option>)}</select></label><label>Trier <select name="sort"><option value="recent">Plus récents</option><option value="name" selected={Astro.url.searchParams.get('sort')==='name'}>Nom</option></select></label><button type="submit">Rechercher</button><a href="/tools">Réinitialiser</a></form>}{unavailable&&<p class="ws-api-error" role="alert">Le service est momentanément indisponible. Réessayez dans quelques instants.</p>}
          <p class="ws-result-status" role="status" hidden></p>
          <div class="ws-tool-grid" data-layout="grid">{tools.map(item=>{const CardLink=preview?'button':'a';return <article class="ws-tool-card" data-id={item.tool.id} data-tool-category={preview?item.category:item.tool.category} data-tool-mode={item.mode} data-favorite={item.favorite?'true':'false'} data-installed={item.installed?'true':'false'}><CardLink href={preview?undefined:`/tools/${encodeURIComponent(item.tool.id)}`} type={preview?'button':undefined} class="ws-tool-open" data-tool-title={item.tool.name} data-tool-summary={item.tool.summary}><span class="ws-card-top"><span class:list={['ws-glyph',`ws-icon-${item.category}`]} aria-hidden="true">{item.glyph}</span><span class="ws-platforms">{item.mode==='both'?'WEB · LOCAL':item.mode==='local'?'LOCAL':'WEB'}</span></span><h3>{item.tool.name}</h3><p>{item.tool.summary}</p></CardLink><button class="ws-favorite" type="button" aria-label={`Favori : ${item.tool.name}`} aria-pressed={item.favorite?'true':'false'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3L2.9 9.6l6.3-.9Z"/></svg></button></article>;})}</div>
          <Pagination next={next}/>{!preview&&pageKind==='home'&&<p class="ws-pagination"><a href="/tools">Parcourir tous les outils →</a></p>}<p class="ws-no-results" hidden={tools.length>0||unavailable}>Aucun outil ne correspond à votre recherche.</p>
        </section>
      </div>
    </main>
  </section>
  {!preview&&!execution&&<SearchDialog client:load/>}
  <dialog class="ws-dialog" id="ws-dialog" aria-labelledby="ws-dialog-title"><form method="dialog"><button class="ws-dialog-close" aria-label="Fermer">×</button></form><h2 id="ws-dialog-title"></h2><p></p></dialog>
</div>
<script>import '../scripts/workspace';</script>
