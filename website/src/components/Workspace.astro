---
import {categories,type WorkspaceTool,type RecentItem} from '../lib/workspace';
import {isToolSummary} from '../lib/tools';
interface Props {tools:WorkspaceTool[];recent?:RecentItem[];preview?:boolean;unavailable?:boolean;hasMore?:boolean;connection?:{connected:boolean;description:string};account?:{initials:string;subtitle:string};}
const {tools,recent=[],preview=false,unavailable=false,hasMore=false,connection={connected:false,description:'Connectez Kortex Desktop pour retrouver vos outils locaux.'},account={initials:'K',subtitle:'Sans connexion'}}=Astro.props;
if(!tools.every(t=>isToolSummary(t.tool)))throw Error('Invalid workspace tools');
const groups=tools.some(t=>t.category==='other')?[...categories,{id:'other',label:'Autres'}]:categories;
const nav=[{id:'home',label:'Accueil',count:null},{id:'all',label:'Tous les outils',count:tools.length},{id:'favorites',label:'Favoris',count:tools.filter(t=>t.favorite).length},{id:'installed',label:'Installés',count:tools.filter(t=>t.installed).length}];
---
<div class="workspace" data-demo={preview?'true':'false'}>
  <aside class="ws-sidebar" id="workspace-sidebar" aria-label="Navigation de l’espace de travail">
    <a class="ws-brand" href={preview?'/__dev/design':'/'} aria-label="Kortex.site — accueil"><span class="ws-brand-mark" aria-hidden="true"></span><span><strong>kortex</strong><span class="ws-brand-site">.site</span></span><span class="ws-beta">BETA</span></a>
    <button class="ws-new-task" type="button" data-new-task>Nouvelle tâche <kbd aria-hidden="true">⌘N</kbd></button>
    <nav class="ws-nav" aria-label="Espace de travail">{nav.map(item=><button type="button" class:list={['ws-nav-item',item.id==='home'&&'is-active']} data-section={item.id} aria-current={item.id==='home'?'page':undefined}><span class="ws-nav-icon" aria-hidden="true"></span><span>{item.label}</span>{item.count!==null&&<span class="ws-count" data-count={item.id}>{item.count}{item.id==='all'&&hasMore?'+':''}</span>}</button>)}</nav>
    <div class="ws-categories"><p class="ws-category-heading">CATÉGORIES</p><nav aria-label="Catégories">{groups.map(group=><button type="button" class="ws-category" data-category={group.id}><span class:list={['ws-category-dot',`ws-color-${group.id}`]} aria-hidden="true"></span><span>{group.label}</span><span class="ws-count">{tools.filter(t=>t.category===group.id).length}</span></button>)}</nav></div>
    <div class="ws-sidebar-bottom"><div class="ws-connection"><p><span class:list={['ws-connection-dot',connection.connected&&'is-connected']} aria-hidden="true"></span>{connection.connected?'App locale connectée':'App locale non connectée'}</p><span>{connection.description}</span></div><button type="button" class="ws-account" data-open-account><span class="ws-avatar">{account.initials}</span><span><strong>Mon espace</strong><span>{account.subtitle}</span></span></button></div>
  </aside>
  <div class="ws-drawer-backdrop" hidden></div>
  <section class="ws-main-panel">
    <header class="ws-topbar"><button class="ws-mobile-menu" type="button" aria-expanded="false" aria-controls="workspace-sidebar" aria-label="Ouvrir le menu">☰</button><div class="ws-breadcrumb"><span>Espace de travail</span><span aria-hidden="true">/</span><strong id="ws-page-name">Accueil</strong></div><div class="ws-topbar-actions"><form class="ws-global-search" role="search" aria-label="Rechercher partout" action={preview?'/__dev/design':'/'}><span class="ws-search-circle" aria-hidden="true"></span><label class="sr-only" for="ws-global-query">Rechercher partout</label><input id="ws-global-query" name="q" type="search" placeholder="Rechercher partout" maxlength="200"/><kbd aria-hidden="true">⌘K</kbd></form><button class="ws-docs" type="button" data-open-docs>Docs</button></div></header>
    <main class="ws-scroll" id="workspace-main" tabindex="-1">
      <div class="ws-content">
        <section class="ws-hero" aria-labelledby="workspace-title"><h1 id="workspace-title">Que voulez-vous faire aujourd'hui ?</h1><p class="ws-subtitle">Décrivez votre besoin ou déposez un fichier. Kortex propose le bon outil.</p>
          <form class="ws-composer" action={preview?'/__dev/design':'/'} method="get"><label class="sr-only" for="ws-task">Décrivez votre besoin</label><textarea id="ws-task" name="q" placeholder="Ex. compresser 40 photos pour le web, convertir un PDF en Word..." maxlength="2000"></textarea><div class="ws-composer-footer"><button class="ws-attach" type="button">+ Déposer un fichier</button><input id="ws-file" type="file" class="sr-only" tabindex="-1" aria-label="Choisir un fichier"/><fieldset class="ws-modes"><legend class="sr-only">Disponibilité des outils</legend>{[['all','Tous'],['web','En ligne'],['local','Local']].map(([value,label])=><label><input type="radio" name="mode" value={value} checked={value==='all'}/><span>{label}</span></label>)}</fieldset><button class="ws-send" type="submit" aria-label="Trouver le bon outil"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 21V3m-5 6 5-6 5 6"/></svg></button></div><p class="ws-file-status" hidden></p></form>
          <div class="ws-suggestions" aria-label="Suggestions de tâches">{['Compresser une image','PDF vers Word','Formater du JSON','Créer un QR code'].map(label=><button type="button" data-suggestion={label}>{label}</button>)}</div>
        </section>
        <section class="ws-recent" aria-labelledby="ws-recent-title"><div class="ws-section-heading"><h2 id="ws-recent-title">Récents</h2><button class="ws-text-button" type="button" data-show-recent>Tout voir</button></div><div class="ws-recent-grid">{recent.map(item=><button type="button" class="ws-recent-card" data-recent={item.name}><span class:list={['ws-glyph',`ws-icon-${item.category}`]} aria-hidden="true">{item.glyph}</span><span><strong>{item.name}</strong><span>{item.subtitle}</span></span></button>)}{!recent.length&&<p class="ws-empty-recent">Vos activités récentes s’afficheront ici.</p>}</div></section>
        <section class="ws-library" id="workspace-tools" aria-labelledby="ws-tools-title"><div class="ws-section-heading"><h2 id="ws-tools-title">Tous les outils <span id="ws-visible-count">{tools.length} outils{hasMore?' affichés':''}</span></h2><div class="ws-view-switch" role="group" aria-label="Affichage des outils"><button type="button" data-view="grid" aria-pressed="true">Grille</button><button type="button" data-view="list" aria-pressed="false">Liste</button></div></div>
          {unavailable&&<p class="ws-api-error" role="alert">Le service est momentanément indisponible. Réessayez dans quelques instants.</p>}
          <p class="ws-result-status" role="status" hidden></p>
          <div class="ws-tool-grid" data-layout="grid">{tools.map(item=><article class="ws-tool-card" data-id={item.tool.id} data-tool-category={item.category} data-tool-mode={item.mode} data-favorite={item.favorite?'true':'false'} data-installed={item.installed?'true':'false'}><button type="button" class="ws-tool-open" data-tool-title={item.tool.name} data-tool-summary={item.tool.summary}><span class="ws-card-top"><span class:list={['ws-glyph',`ws-icon-${item.category}`]} aria-hidden="true">{item.glyph}</span><span class="ws-platforms">{item.mode==='both'?'WEB · LOCAL':item.mode==='local'?'LOCAL':'WEB'}</span></span><h3>{item.tool.name}</h3><p>{item.tool.summary}</p></button><button class="ws-favorite" type="button" aria-label={`Favori : ${item.tool.name}`} aria-pressed={item.favorite?'true':'false'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3L2.9 9.6l6.3-.9Z"/></svg></button></article>)}</div>
          <p class="ws-no-results" hidden>Aucun outil ne correspond à votre recherche.</p>
        </section>
      </div>
    </main>
  </section>
  <dialog class="ws-dialog" id="ws-dialog" aria-labelledby="ws-dialog-title"><form method="dialog"><button class="ws-dialog-close" aria-label="Fermer">×</button></form><h2 id="ws-dialog-title"></h2><p></p></dialog>
</div>
<script>import '../scripts/workspace';</script>
