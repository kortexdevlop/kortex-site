---
import {categories,type WorkspaceTool,type RecentItem} from '../lib/workspace';
import SearchDialog from './ui/SearchDialog';
import Pagination from './ui/Pagination.astro';
import {isToolSummary} from '../lib/tools';
import Icon from './ui/Icon.astro';
import WsSearch from './ui/WsSearch.astro';
interface Props {tools:WorkspaceTool[];execution?:boolean;pageKind?:'home'|'catalog'|'detail';next?:string|null;recent?:RecentItem[];preview?:boolean;unavailable?:boolean;hasMore?:boolean;connection?:{connected:boolean;description:string};account?:{initials:string;subtitle:string};}
const {tools,execution=false,pageKind='home',next=null,recent=[],preview=false,unavailable=false,hasMore=false,connection={connected:false,description:'Connectez Kortex Desktop pour retrouver vos outils locaux.'},account={initials:'K',subtitle:'Sans connexion'}}=Astro.props;
if(!tools.every(t=>isToolSummary(t.tool)))throw Error('Invalid workspace tools');
const groups=preview?(tools.some(t=>t.category==='other')?[...categories,{id:'other',label:'Autres'}]:categories):[...new Set([...tools.map(t=>t.tool.category),...(Astro.url.searchParams.get('category')?[Astro.url.searchParams.get('category')!]:[])])].sort().map(id=>({id,label:categories.find(c=>c.id===id)?.label||id}));
const labelOf=(id:string)=>categories.find(c=>c.id===id)?.label||id;
const feature=pageKind==='catalog'&&!Astro.url.searchParams.get('q')&&!Astro.url.searchParams.get('category')&&!Astro.url.searchParams.get('cursor')?tools[0]:undefined;
const specialPage=/^\/workspace(?:\/|$)/.test(Astro.url.pathname)?'Bureau':/^\/workflows(?:\/|$)/.test(Astro.url.pathname)?'Workflows':/^\/ai(?:\/|$)/.test(Astro.url.pathname)?'Assistant':null;
const desk=specialPage==='Bureau';
const nav=[{id:'home',label:'Accueil',count:null},{id:'all',label:'Tous les outils',count:pageKind==='detail'?null:tools.length},{id:'favorites',label:'Favoris',count:pageKind==='detail'?null:tools.filter(t=>t.favorite).length},{id:'installed',label:'Installés',count:pageKind==='detail'?null:tools.filter(t=>t.installed).length}];
---
<div class="workspace" data-demo={preview?'true':'false'} data-page-kind={pageKind} data-execution={execution?'true':undefined} data-frame={desk?'desk':undefined}>
  <header class="ws-topbar"><button class="ws-mobile-menu" type="button" aria-expanded="false" aria-controls="workspace-sidebar" aria-label="Ouvrir le menu">☰</button>{desk?<nav class="ws-trail" aria-label="Fil d’Ariane"><span>Espace de travail</span><span aria-hidden="true">›</span><strong id="ws-page-name">{specialPage??(pageKind==='home'?'Accueil':pageKind==='catalog'?'Tous les outils':'Outil')}</strong></nav>:<><a class="ws-brand" href={preview?'/__dev/design':'/'}><span class="ws-brand-mark" aria-hidden="true"></span><strong>{specialPage?`Kortex ${specialPage}`:'Kortex Store'}</strong><span class="sr-only"> — accueil</span></a><p class="sr-only">Espace de travail / <span id="ws-page-name">{specialPage??(pageKind==='home'?'Accueil':pageKind==='catalog'?'Tous les outils':'Outil')}</span></p><div class="ws-topbar-center"><WsSearch preview={preview}/></div></>}<div class="ws-topbar-actions" hidden={desk}><button class="ws-docs" type="button" data-open-docs>Docs</button>{!preview&&<a class="ws-login" href="/account">Mon compte</a>}</div></header>
  <aside class="ws-sidebar" id="workspace-sidebar" aria-label="Navigation de l’espace de travail">
    {desk&&<a class="ws-side-brand" href="/"><span class="ws-brand-mark" aria-hidden="true"></span><span><strong>kortex<em>.site</em></strong><small>Workspace</small></span><span class="sr-only"> — accueil</span></a>}
    {desk&&<WsSearch placeholder="Rechercher"/>}
    {preview&&<button class="ws-new-task" type="button" data-new-task>Nouvelle tâche <kbd aria-hidden="true">⌘N</kbd></button>}
    <div class="ws-nav-group">
    <nav class="ws-nav" aria-label="Espace de travail">{nav.map(item=><button type="button" class:list={['ws-nav-item',!specialPage&&item.id===(pageKind==='home'?'home':'all')&&'is-active']} data-section={item.id} aria-current={!specialPage&&item.id===(pageKind==='home'?'home':'all')?'page':undefined}><span class="ws-nav-icon"><Icon name={({home:'home',all:'compass',favorites:'star',installed:'library'} as Record<string,string>)[item.id]}/></span><span>{item.label}</span>{item.count!==null&&<span class="ws-count" data-count={item.id}>{item.count}{item.id==='all'&&hasMore?'+':''}</span>}</button>)}</nav>
    {!preview&&<a class:list={['ws-nav-item',specialPage==='Assistant'&&'is-active']} aria-current={specialPage==='Assistant'?'page':undefined} href="/ai"><span class="ws-nav-icon"><Icon name="bolt"/></span><span>Assistant</span></a>}
    {!preview&&<a class:list={['ws-nav-item',specialPage==='Workflows'&&'is-active']} aria-current={specialPage==='Workflows'?'page':undefined} href="/workflows"><span class="ws-nav-icon"><Icon name="flow"/></span><span>Workflows</span></a>}
    {!preview&&<a class:list={['ws-nav-item',specialPage==='Bureau'&&'is-active']} aria-current={specialPage==='Bureau'?'page':undefined} href="/workspace"><span class="ws-nav-icon"><Icon name="desk"/></span><span>Bureau</span></a>}
    </div>
    <div class="ws-categories" hidden={!groups.length}><p class="ws-category-heading">CATÉGORIES</p><nav aria-label="Catégories">{groups.map(group=><button type="button" class="ws-category" data-category={group.id}><span class:list={['ws-tile ws-tile-s',`ws-hue-${group.id}`]}><Icon name={group.id} size={13} stroke={2}/></span><span>{group.label}</span><span class="ws-count">{tools.filter(t=>(preview?t.category:t.tool.category)===group.id).length}</span></button>)}</nav></div>
    <div class="ws-sidebar-bottom">{!desk&&<div class="ws-connection"><p><span class:list={['ws-connection-dot',connection.connected&&'is-connected']} aria-hidden="true"></span>{connection.connected?'App locale connectée':'App locale non connectée'}</p><span>{connection.description}</span></div>}<button type="button" class="ws-account" data-open-account><span class="ws-avatar">{account.initials}</span><span><strong>Mon espace</strong><span>{account.subtitle}</span></span></button>{desk&&<div class="ws-promo"><p><span class="ws-promo-mark"><Icon name="library" size={15}/></span>Kortex Store</p><span>Installez vos outils sur Windows.</span><a href="/telechargement">Télécharger</a></div>}</div>
  </aside>
  <div class="ws-drawer-backdrop" hidden></div>
  <section class="ws-main-panel">
    <main class="ws-scroll" id="workspace-main" tabindex="-1">
      <div class="ws-content">
        <section hidden={pageKind!=='home'} class="ws-hero" aria-labelledby="workspace-title"><h1 id="workspace-title">Que voulez-vous faire aujourd'hui ?</h1><p class="ws-subtitle">Décrivez votre besoin ou déposez un fichier. Kortex propose le bon outil.</p>
          <form class="ws-composer" action={preview?'/__dev/design':'/'} method="get"><label class="sr-only" for="ws-task">Décrivez votre besoin</label><textarea id="ws-task" name="q" placeholder="Ex. compresser 40 photos pour le web, convertir un PDF en Word..." maxlength="2000"></textarea><div class="ws-composer-footer"><button class="ws-attach" type="button">+ Déposer un fichier</button><input id="ws-file" type="file" class="sr-only" tabindex="-1" aria-label="Choisir un fichier"/><fieldset class="ws-modes"><legend class="sr-only">Disponibilité des outils</legend>{[['all','Tous'],['web','En ligne'],['local','Local']].map(([value,label])=><label><input type="radio" name="mode" value={value} checked={value==='all'}/><span>{label}</span></label>)}</fieldset><button class="ws-send" type="submit" aria-label="Trouver le bon outil"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M12 21V3m-5 6 5-6 5 6"/></svg></button></div><p class="ws-file-status" hidden></p></form>
          <div class="ws-suggestions" aria-label="Suggestions de tâches">{['Compresser une image','PDF vers Word','Formater du JSON','Créer un QR code'].map(label=><button type="button" data-suggestion={label}>{label}</button>)}</div>
        </section>
        <section hidden={pageKind!=='home'} class="ws-recent" aria-labelledby="ws-recent-title"><div class="ws-section-heading"><h2 id="ws-recent-title">Récents</h2><button class="ws-text-button" type="button" data-show-recent>Tout voir</button></div><div class="ws-recent-grid">{recent.map(item=><button type="button" class="ws-recent-card" data-recent={item.name}><span class:list={['ws-glyph',`ws-icon-${item.category}`]} aria-hidden="true">{item.glyph}</span><span><strong>{item.name}</strong><span>{item.subtitle}</span></span></button>)}{!recent.length&&<p class="ws-empty-recent">Vos activités récentes s’afficheront ici.</p>}</div></section>
        {feature&&<section class="ws-feature" aria-labelledby="ws-feature-title"><div class="ws-feature-text"><span class="ws-feature-tag">À la une</span><h2 id="ws-feature-title">{feature.tool.name}</h2><p>{feature.tool.summary}</p><a class="ws-feature-open" href={`/app/${encodeURIComponent(feature.tool.id)}`}>Ouvrir <Icon name="arrow" size={14} stroke={2}/></a></div><div class="ws-feature-tools">{tools.slice(1,5).map(item=><a href={`/tools/${encodeURIComponent(item.tool.id)}`}><span class:list={['ws-tile ws-tile-m',`ws-hue-${item.tool.category}`]}><Icon name={item.tool.category} size={18}/></span><span>{item.tool.name}</span></a>)}</div></section>}
        <slot/><section hidden={pageKind==='detail'} class="ws-library" id="workspace-tools" aria-labelledby="ws-tools-title"><div class="ws-section-heading"><h2 id="ws-tools-title"><span id="ws-tools-name">Tous les outils</span> <span id="ws-visible-count">{tools.length} outils{hasMore?' affichés':''}</span></h2><div class="ws-view-switch" role="group" aria-label="Affichage des outils"><button type="button" data-view="grid" aria-pressed="true">Grille</button><button type="button" data-view="list" aria-pressed="false">Liste</button></div></div>
          {pageKind==='catalog'&&<form class="ws-catalog-filters" action="/tools"><input type="hidden" name="q" value={Astro.url.searchParams.get('q')||''}/><label>Catégorie <select name="category"><option value="">Toutes</option>{[...new Set(tools.map(t=>t.tool.category))].sort().map(c=><option value={c} selected={Astro.url.searchParams.get('category')===c}>{labelOf(c)}</option>)}</select></label><label>Trier <select name="sort"><option value="recent">Plus récents</option><option value="name" selected={Astro.url.searchParams.get('sort')==='name'}>Nom</option></select></label><button type="submit">Rechercher</button><a href="/tools">Réinitialiser</a></form>}{unavailable&&<p class="ws-api-error" role="alert">Le service est momentanément indisponible. Réessayez dans quelques instants.</p>}
          <p class="ws-result-status" role="status" hidden></p>
          <div class="ws-tool-grid" data-layout="grid">{tools.map(item=>{const CardLink=preview?'button':'a';return <article class="ws-tool-card" data-id={item.tool.id} data-tool-category={preview?item.category:item.tool.category} data-tool-mode={item.mode} data-favorite={item.favorite?'true':'false'} data-installed={item.installed?'true':'false'}><CardLink href={preview?undefined:`/tools/${encodeURIComponent(item.tool.id)}`} type={preview?'button':undefined} class="ws-tool-open" data-tool-title={item.tool.name} data-tool-summary={item.tool.summary}><span class="ws-card-top"><span class:list={['ws-tile',`ws-hue-${item.category}`]}><Icon name={item.category} size={24}/></span><span class="ws-card-name"><h3>{item.tool.name}</h3><span class="ws-card-meta">{labelOf(item.tool.category)} · v{item.tool.version}</span></span></span><p>{item.tool.summary}</p></CardLink><div class="ws-card-foot"><span class="ws-platforms">{item.mode==='both'?'Web · Local':item.mode==='local'?'Local':'Web'}</span>{!preview&&<a class="ws-card-action" href={`/app/${encodeURIComponent(item.tool.id)}`} aria-label={`Ouvrir ${item.tool.name}`}>Ouvrir</a>}</div><button class="ws-favorite" type="button" aria-label={`Favori : ${item.tool.name}`} aria-pressed={item.favorite?'true':'false'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 2.8 5.7 6.3.9-4.6 4.4 1.1 6.3-5.6-3-5.6 3 1.1-6.3L2.9 9.6l6.3-.9Z"/></svg></button></article>;})}</div>
          <Pagination next={next}/>{!preview&&pageKind==='home'&&<p class="ws-pagination"><a href="/tools">Parcourir tous les outils →</a></p>}<p class="ws-no-results" hidden={tools.length>0||unavailable}>Aucun outil ne correspond à votre recherche.</p>
        </section>
        {!preview&&!desk&&<nav class="ws-legal-links" aria-label="Informations légales"><a href="/mentions-legales">Mentions légales</a><a href="/confidentialite">Confidentialité</a><a href="/conditions-utilisation">Conditions d’utilisation</a></nav>}
      </div>
    </main>
  </section>
  {!preview&&!execution&&<SearchDialog client:load/>}
  <dialog class="ws-dialog" id="ws-dialog" aria-labelledby="ws-dialog-title"><form method="dialog"><button class="ws-dialog-close" aria-label="Fermer">×</button></form><h2 id="ws-dialog-title"></h2><p></p></dialog>
</div>
<script>import '../scripts/workspace';</script>
