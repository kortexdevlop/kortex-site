---
import {isToolDetail,type ToolDetail,type ToolSummary} from '../lib/tools';
import {appUrl} from '../lib/urls';
import {categories} from '../lib/workspace';
import Icon from './ui/Icon.astro';
interface Props {detail:ToolDetail;related?:ToolSummary[];}
const {detail,related=[]}=Astro.props;
if(!isToolDetail(detail))throw new Error('Invalid ToolDetail');
const category=detail.tool.category,label=categories.find(c=>c.id===category)?.label||category,permissions=detail.manifest.permissions.length;
const facts=[['Version',detail.tool.version],['Catégorie',label],['Publication',new Date(detail.tool.published_at).toLocaleDateString('fr-FR',{timeZone:'UTC'})],['Permissions',permissions?String(permissions):'Aucune']];
const perks=[['bolt','S’exécute sur votre appareil'],['security','Paquet signé et vérifié avant ouverture'],...(permissions?[]:[['user','Aucune permission sensible demandée']])];
---
<section class="tool-details">
  <div class="td-hero"><span class:list={['ws-tile td-tile',`ws-hue-${category}`]}><Icon name={category} size={40} stroke={1.5}/></span><div class="td-title"><p class="td-category">{label}</p><h1>{detail.tool.name}</h1><p>{detail.manifest.description}</p></div><a class="td-open" href={appUrl(detail.tool.id)}>Ouvrir</a></div>
  <dl class="td-facts">{facts.map(([name,value])=><div><dt>{name}</dt><dd>{value}</dd></div>)}</dl>
  <div class="td-columns">
    <div class="td-panel"><h2>Actions disponibles</h2><ul>{detail.contract.actions.map(action=><li>{action.description}</li>)}</ul></div>
    <div class="td-panel"><h2>Fonctionne sur votre appareil</h2>{perks.map(([name,text])=><p class="td-perk"><span><Icon name={name} size={16}/></span>{text}</p>)}</div>
  </div>
  {detail.tool.tags.length>0&&<ul class="td-tags" aria-label="Mots-clés">{detail.tool.tags.map(tag=><li>{tag}</li>)}</ul>}
  {related.length>0&&<div class="td-related"><h2>Dans la même catégorie</h2><div>{related.map(tool=><a href={`/tools/${encodeURIComponent(tool.id)}`}><span class:list={['ws-tile td-tile-s',`ws-hue-${tool.category}`]}><Icon name={tool.category} size={18}/></span><span>{tool.name}</span></a>)}</div></div>}
</section>
