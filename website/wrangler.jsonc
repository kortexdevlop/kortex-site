{
  "$schema":"./node_modules/wrangler/config-schema.json",
  "name":"kortex-web-local",
  "main":"@astrojs/cloudflare/entrypoints/server",
  "compatibility_date":"2026-10-26",
  "compatibility_flags":["nodejs_compat"],
  "workers_dev":false,
  "preview_urls":false,
  "send_metrics":false,
  "assets":{"directory":"./dist/client", "binding":"ASSETS"},
  "vars":{"WEB_ORIGIN":"http://127.0.0.1:4321"},
  "services":[{"binding":"API_WORKER", "service":"kortex-api-local"}],
  "env":{
    "staging":{
      "name":"kortex-web-staging", "workers_dev":false,
      "vars":{"WEB_ORIGIN":"https://staging.kortex.site"},
      "services":[{"binding":"API_WORKER", "service":"kortex-api-staging"}]
    },
    "production":{
      "name":"kortex-web-production", "workers_dev":false,
      "vars":{"WEB_ORIGIN":"https://kortex.site"},
      "services":[{"binding":"API_WORKER", "service":"kortex-api-production"}]
    }
  }
}
