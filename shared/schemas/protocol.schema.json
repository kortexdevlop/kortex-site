{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/reply"
    }
  ],
  "$defs": {
    "request": {
      "type": "object",
      "properties": {
        "v": {
          "const": 1
        },
        "request_id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "kind": {
          "enum": [
            "init",
            "render",
            "ui.event",
            "action.invoke",
            "capability.result",
            "state.restore",
            "shutdown"
          ]
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "v",
        "request_id",
        "kind",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "capability.result"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "capability_request_id": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "ok": {
                    "type": "boolean"
                  },
                  "data": {
                    "type": "object",
                    "additionalProperties": true
                  },
                  "error": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 100
                      },
                      "message": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "retryable": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "code",
                      "message",
                      "retryable"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "capability_request_id",
                  "ok"
                ],
                "additionalProperties": false,
                "oneOf": [
                  {
                    "properties": {
                      "ok": {
                        "const": true
                      },
                      "error": false
                    }
                  },
                  {
                    "properties": {
                      "ok": {
                        "const": false
                      },
                      "error": {
                        "type": "object",
                        "properties": {
                          "code": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 100
                          },
                          "message": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 2000
                          },
                          "retryable": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "code",
                          "message",
                          "retryable"
                        ],
                        "additionalProperties": false
                      },
                      "data": false
                    },
                    "required": [
                      "error"
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "reply": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "v": {
              "const": 1
            },
            "request_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "ok": {
              "const": true
            },
            "data": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "required": [
            "v",
            "request_id",
            "ok"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "v": {
              "const": 1
            },
            "request_id": {
              "type": "string",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
            },
            "ok": {
              "const": false
            },
            "error": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "message": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "retryable": {
                  "type": "boolean"
                }
              },
              "required": [
                "code",
                "message",
                "retryable"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "v",
            "request_id",
            "ok",
            "error"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
