{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kortex.site/schemas/workspace-1.0.json",
  "title": "Kortex workspace metadata 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_version",
    "windows",
    "focused"
  ],
  "properties": {
    "workspace_version": {
      "const": "1.0"
    },
    "focused": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 36
    },
    "windows": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "window_id",
          "instance_id",
          "tool_id",
          "version",
          "bounds",
          "mode",
          "z"
        ],
        "properties": {
          "window_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
          },
          "instance_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{8}(-[a-f0-9]{4}){3}-[a-f0-9]{12}$"
          },
          "tool_id": {
            "type": "string",
            "minLength": 3,
            "maxLength": 64,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
          },
          "bounds": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "width": {
                "type": "number",
                "minimum": 320
              },
              "height": {
                "type": "number",
                "minimum": 240
              }
            }
          },
          "mode": {
            "enum": [
              "normal",
              "minimized",
              "maximized"
            ]
          },
          "z": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          }
        }
      }
    }
  }
}
