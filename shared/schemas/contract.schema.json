{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "contract_version": {
      "const": "1.0"
    },
    "tool_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "input_schema": {
            "$ref": "#/$defs/valueSchema"
          },
          "output_schema": {
            "$ref": "#/$defs/valueSchema"
          },
          "permissions": {
            "type": "array",
            "maxItems": 7,
            "uniqueItems": true,
            "items": {
              "enum": [
                "storage.read",
                "storage.write",
                "file.pick",
                "file.read",
                "file.save",
                "network.fetch",
                "clipboard.write"
              ]
            }
          },
          "side_effect": {
            "enum": [
              "none",
              "local-write",
              "network"
            ]
          },
          "idempotent": {
            "type": "boolean"
          },
          "timeout_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30000
          }
        },
        "required": [
          "id",
          "description",
          "input_schema",
          "output_schema",
          "permissions",
          "side_effect",
          "idempotent",
          "timeout_ms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "contract_version",
    "tool_id",
    "actions"
  ],
  "additionalProperties": false,
  "$defs": {
    "valueSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "object",
            "array",
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "properties": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "additionalProperties": {
            "$ref": "#/$defs/valueSchema"
          }
        },
        "required": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "additionalProperties": {
          "type": "boolean"
        },
        "items": {
          "$ref": "#/$defs/valueSchema"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        },
        "minimum": {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "maximum": {
          "type": "number",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "minLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "maxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1048576
        },
        "minItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "maxItems": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        }
      }
    }
  }
}
