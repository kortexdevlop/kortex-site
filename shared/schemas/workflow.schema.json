{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "workflow_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "action_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 129,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*\\.[a-z][a-z0-9_-]*$"
          },
          "input_bindings": {
            "type": "object",
            "maxProperties": 100,
            "propertyNames": {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "value": {}
                  },
                  "required": [
                    "value"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "from_node": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64,
                      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                    },
                    "source_pointer": {
                      "type": "string",
                      "maxLength": 1024,
                      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
                    }
                  },
                  "required": [
                    "from_node",
                    "source_pointer"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "requires_confirmation": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "action_ref",
          "input_bindings",
          "requires_confirmation"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          }
        },
        "required": [
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "maxItems": 1000
    }
  },
  "required": [
    "workflow_version",
    "id",
    "name",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
