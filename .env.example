# Non-secret template. Production values belong in protected environment settings.
KORTEX_ENV=local
PUBLIC_WEB_ORIGIN=http://localhost:4321
PUBLIC_API_ORIGIN=http://localhost:8787
PUBLIC_RUN_ORIGIN=http://localhost:4322
# Required in staging/production; empty locally while login is disabled.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Step 14.0: optional identity configuration; legacy generic keys above retained.
OIDC_ENABLED=false
OIDC_WEB_CLIENT_ID=
OIDC_DESKTOP_CLIENT_ID=
OIDC_WEB_REDIRECT_URI=
OIDC_DESKTOP_REDIRECT_URI=
OIDC_ENDPOINT_ORIGINS=
OIDC_WEB_CLIENT_SECRET=
SESSION_HMAC_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_R2_BUCKET=
KORTEX_SIGNING_KEY_ID=
KORTEX_SIGNING_PUBLIC_KEY=
# Private signing key: CI secret only. Never copy to browser or local template.
# KORTEX_SIGNING_KEY_SEED_BASE64 is injected into the signing CI process only, never application .env.
